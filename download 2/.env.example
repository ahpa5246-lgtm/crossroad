APP_NAME="مفترق الطرق"
APP_URL=https://testtest.gt.tc
APP_ENV=production
APP_DEBUG=false
APP_KEY=

DB_PATH=database/muntalaq.sqlite

# Upload limits
UPLOAD_MAX_MB=3
IMAGE_QUALITY=82
IMAGE_MAX_WIDTH=1200

# Support Bot
SUPPORT_BOT_URL=

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
DIAG_SECRET=

# SMTP — Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="مفترق الطرق"
SMTP_FROM_EMAIL=

# Ollama Cloud API
# الحصول على المفتاح من: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
# اتركه فارغاً لاستخدام السحابة، أو ضع http://localhost:11434 للمحلي
OLLAMA_ENDPOINT=https://api.ollama.com

# ── Google OAuth (تسجيل الدخول عبر Gmail) ─────────────────
# 1) console.cloud.google.com → APIs & Services → Credentials → Create OAuth client ID (Web application)
# 2) Authorized redirect URI يجب أن يطابق الرابط التالي تماما:
#       https://testtest.gt.tc/auth/google/callback
# 3) انسخ القيمتين هنا. إذا تُركا فارغتين يختفي زر Google من الموقع.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# اتركه فارغا ليُبنى تلقائيا من APP_URL:  APP_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

